# Copy to .env and fill in. Values are optional; missing keys fall back to
# seeded demo/stub data automatically.

# Mouser Search API key (https://www.mouser.com/api-hub/)
MOUSER_API_KEY=

# DigiKey OAuth2 2-legged application credentials (https://developer.digikey.com)
DIGIKEY_CLIENT_ID=
DIGIKEY_CLIENT_SECRET=

# Nexar OAuth2 client_credentials (https://identity.nexar.com)
NEXAR_CLIENT_ID=
NEXAR_CLIENT_SECRET=

# Arrow Electronics API key (https://developers.arrow.com)
ARROW_API_KEY=
# ARROW_LOGIN=              # optional account e-mail for personalised quotes

# Farnell / element14 Product Search API (https://partner.element14.com)
FARNELL_API_KEY=
# FARNELL_STORE=            # e.g. uk.farnell.com, in.element14.com

# LCSC open API (https://www.lcsc.com -> Account -> Open API)
LCSC_API_KEY=
LCSC_API_SECRET=

# TrustedParts authorised-distributor stock (https://www.trustedparts.com)
TRUSTEDPARTS_API_KEY=

# Where the SQLite database lives (default: ./data/part_intel.db)
# DATABASE_URL=sqlite:///./data/part_intel.db