# BOM-IQ environment configuration (optional).
#
# Copy to ".env" next to the app, in the working directory, or in the config
# folder. Environment variables always take priority over stored credentials,
# which makes this the easiest way to wire BOM-IQ into CI.
#
# See docs/API_KEYS.md for how to obtain each key.

# --- Octopart / Nexar -- the single most valuable provider for risk work ----
# NEXAR_CLIENT_ID=
# NEXAR_CLIENT_SECRET=

# --- Mouser -- one simple key, quickest to get -----------------------------
# MOUSER_API_KEY=

# --- DigiKey -- deepest parametrics and compliance data --------------------
# DIGIKEY_CLIENT_ID=
# DIGIKEY_CLIENT_SECRET=
# DIGIKEY_CUSTOMER_ID=          # optional: returns your contract pricing

# --- Arrow ------------------------------------------------------------------
# ARROW_API_KEY=
# ARROW_LOGIN=

# --- Farnell / element14 / Newark ------------------------------------------
# FARNELL_API_KEY=
# FARNELL_STORE=uk.farnell.com  # uk.farnell.com | de.farnell.com |
#                               # in.element14.com | sg.element14.com |
#                               # www.newark.com  | canada.newark.com

# --- LCSC (disabled by default; public endpoints are unofficial) -----------
# LCSC_API_KEY=
# LCSC_API_SECRET=
# BOMIQ_LCSC_BASE_URL=

# --- TrustedParts (partner feed) -------------------------------------------
# TRUSTEDPARTS_API_KEY=
# BOMIQ_TRUSTEDPARTS_BASE_URL=

# --- Application settings ---------------------------------------------------
# Any field in bomiq/config.py Settings can be set as BOMIQ_<FIELD_NAME>.
# BOMIQ_BUILD_QUANTITY=500
# BOMIQ_CURRENCY=USD
# BOMIQ_TARGET_REGION=global        # global | emea | apac | india | americas
# BOMIQ_PROVIDERS=nexar,mouser,digikey
# BOMIQ_OFFLINE=0                   # 1 forces the built-in offline catalogue
# BOMIQ_MAX_WORKERS=8
# BOMIQ_PART_CACHE_TTL=21600        # seconds
# BOMIQ_LEAD_TIME_WARN_DAYS=84
# BOMIQ_MIN_SOURCES_OK=2
# BOMIQ_REQUIRE_ROHS=1
# BOMIQ_REQUIRE_REACH=0
# BOMIQ_LOG_LEVEL=INFO              # DEBUG | INFO | WARNING | ERROR
# BOMIQ_PORT=8756

# --- Paths (override where data and settings live) -------------------------
# BOMIQ_DATA_DIR=
# BOMIQ_CONFIG_DIR=
